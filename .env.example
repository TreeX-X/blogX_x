# BlogX_x 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 gitignore，不会进仓库）。
# 只列运行时必需的项；可选项给了默认值。

# ---- 内容真源（LanceDB Cloud）----
# content 表是全部集合内容的唯一真源；blog_index 是其派生向量索引。
# Used by: src/lib/content-store.ts、src/lib/article-db.ts、scripts/content-pull.mjs、scripts/init-db.mjs
LANCEDB_URI="db://your-db-name"
LANCEDB_API_KEY="your-lancedb-key"
LANCEDB_TABLE="blog_index"
LANCEDB_LOCAL_PATH=".lancedb"
# true 时云端不可达即让构建失败（CI/Vercel 用）；本地开发留 false 以离线可用
LANCEDB_CLOUD_REQUIRED="false"
EMBEDDING_DIM="1024"

# ---- 向量模型 ----
# Used by: scripts/init-db.mjs、src/pages/api/ai-search.ts
SF_TOKEN="your-embedding-token"
SF_MODEL="BAAI/bge-m3"

# ---- 外部 LLM（OpenAI 兼容接口）----
# 翻译（唯一实现）、frontmatter 提取、留言 AI 审核共用这三项。
# 任何 OpenAI 兼容端点均可：<LLM_BASE_URL>/chat/completions，Bearer 鉴权，messages 载荷。
# 三项缺一项即报错，不内置供应商默认值——换提供商只改这里。
LLM_API_KEY="your-llm-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# ---- AI 搜索行为 ----
# Used by: src/pages/api/ai-search.ts、src/pages/api/search.ts、src/pages/api/knowledge-graph.ts
AI_SEARCH_RATE_LIMIT="5"
SEARCH_ALLOW_LOCAL_FALLBACK="true"
KG_MAX_NODES="36"
KG_MAX_EDGES_PER_NODE="5"
KG_MIN_NEIGHBORS_PER_NODE="3"
KG_MIN_SIMILARITY="0.35"

# ---- Redis（留言 / 点子）----
# Used by: src/lib/kv-messages.ts
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
MESSAGE_RATE_LIMIT_IP="3"
MESSAGE_RATE_LIMIT_GLOBAL="50"
MESSAGE_RATE_LIMIT_WINDOW="60"
MESSAGE_RATE_LIMIT_IP_WINDOW="300"
MESSAGE_MAX_DISPLAY="20"

# ---- 管理面板（仅 dev 可用，生产零写入面）----
# Used by: src/lib/admin-auth.ts、src/pages/api/admin/login.ts
ADMIN_PASSWORD="your-admin-password"
ADMIN_SESSION_SECRET="your-session-secret"

# ---- 内容发布 ----
# dev 面板或 content:publish 发布内容后触发 Vercel 重建。
# 在 Vercel 项目 → Settings → Git → Deploy Hooks 创建，把完整 URL 填在这里。
# 留空则只警告不阻断：内容已入表，但站点不会自动更新。
VERCEL_DEPLOY_HOOK=""
