{
  "name": "blogx-x",
  "type": "module",
  "version": "0.0.1",
  "//": "content:intake / content:publish（AI 上传处理通道）另依赖一个环境变量：VERCEL_DEPLOY_HOOK —— Vercel 项目 → Settings → Git → Deploy Hooks 创建的完整 URL，填在 .env 里。内容出仓后 content 表的变更不会触发重建，发布必须主动打这个钩子；变量缺失时发布仍会把草稿写入 content 表，但脚本与面板都会明确警告站点不会自动重建。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node --experimental-strip-types scripts/content-pull.mjs",
    "prebuild": "node --experimental-strip-types scripts/content-pull.mjs && node scripts/pack-skills.mjs",
    "build": "node scripts/init-db.mjs && node --experimental-strip-types scripts/fetch-articles.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync-kb": "node scripts/sync-obsidian-kb.mjs --list",
    "sync-kb:import": "node scripts/sync-obsidian-kb.mjs --to-lancedb",
    "init-db": "node scripts/init-db.mjs",
    "mcp:kb": "node scripts/kb-mcp-server.mjs",
    "mcp:kb:http": "node scripts/kb-mcp-http-server.mjs",
    "fetch-articles": "node --experimental-strip-types scripts/fetch-articles.mjs",
    "fetch-articles:translate": "node --experimental-strip-types scripts/fetch-articles.mjs",
    "content:pull": "node --experimental-strip-types scripts/content-pull.mjs",
    "content:migrate": "node scripts/content-migrate.mjs",
    "content:intake": "node --experimental-strip-types scripts/content-intake.mjs",
    "content:publish": "node --experimental-strip-types scripts/content-publish.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "maintenance:status": "node scripts/maintenance.mjs status",
    "maintenance:fix": "node scripts/maintenance.mjs fix",
    "maintenance:verify": "node scripts/maintenance.mjs verify",
    "test:kg": "node scripts/test-knowledge-graph.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@astrojs/vercel": "^10.0.4",
    "@lancedb/lancedb": "^0.27.2",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/d3-force": "^3.0.10",
    "@vercel/kv": "^3.0.0",
    "astro": "^6.1.5",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.12.0",
    "linkedom": "^0.18.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "^1.29.1",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "archiver": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
