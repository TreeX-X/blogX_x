---
import BaseLayout from "../layouts/BaseLayout.astro";
import FunMessages from "../components/FunMessages";
import IdeaBox from "../components/IdeaBox";
import { getProjects } from "../lib/content";
import ProjectPreview from "../components/ProjectPreview";

const base = import.meta.env.BASE_URL;
const toBase = (path = "") => {
  const normalizedBase = base.endsWith("/") ? base.slice(0, -1) : base;
  const normalizedPath = path.startsWith("/") ? path.slice(1) : path;
  return normalizedPath ? `${normalizedBase}/${normalizedPath}` : `${normalizedBase}/`;
};

const funMessagesApi = toBase("api/fun-messages");
const ideasApi = toBase("api/ideas");
const projects = await getProjects();
const githubUsername = "TreeX-X";
const githubContributionsUrl = `https://ghchart.rshah.org/E87040/${githubUsername}`;
const safeImage = (url?: string) => url && (/^https:\/\//i.test(url) || /^\/(?!\/)/.test(url)) ? url : undefined;
const imageUrl = (url?: string) => url?.startsWith("/") ? toBase(url) : url;
---

<BaseLayout title="BlogX_x | 关于" description="关于 BlogX_x 和作者。">
  <!-- About Me -->
  <section>
    <h1 class="section-title">关于我</h1>
    <div class="card about-profile-card">
      <div class="about-profile-head">
        <div class="about-avatar">
          <img src={toBase("about/me.png")} alt="avatar" />
        </div>
        <div class="about-profile-copy">
          <p>
            我在这里记录技术实践、设计思考和知识库沉淀。BlogX_x
            的目标是保持克制表达，长期更新。
          </p>
        </div>
      </div>

      <div class="about-social-wrap">
        <a
          class="github-entry"
          href={`https://github.com/${githubUsername}`}
          target="_blank"
          rel="noreferrer"
          aria-label={`访问 ${githubUsername} 的 GitHub 主页`}
        >
          <span class="github-entry-ring" aria-hidden="true"></span>
          <span class="github-entry-icon-shell" aria-hidden="true">
            <img
              class="github-entry-icon"
              src={toBase("logo/githubLogo.svg")}
              alt=""
            />
          </span>
          <span class="github-entry-text">@{githubUsername} on GitHub</span>
        </a>
      </div>

      <a
        class="github-contrib-card"
        href={`https://github.com/${githubUsername}`}
        target="_blank"
        rel="noreferrer"
        aria-label={`查看 ${githubUsername} 的 GitHub 提交日历`}
      >
        <div class="github-contrib-head">
          <span>GitHub 提交日历</span>
          <span class="github-contrib-user">@{githubUsername}</span>
        </div>
        <div class="github-contrib-visual">
          <img
            src={githubContributionsUrl}
            alt={`${githubUsername} 的 GitHub contributions calendar`}
            loading="lazy"
          />
        </div>
        <div class="github-contrib-foot" aria-hidden="true">
          <span>Less</span>
          <span class="github-contrib-dot level-0"></span>
          <span class="github-contrib-dot level-1"></span>
          <span class="github-contrib-dot level-2"></span>
          <span class="github-contrib-dot level-3"></span>
          <span>More</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Note: 项目预览读取已保存的 README 快照 — see .agents/notes/2026-10-07-decision-project-showcase--617f02c5.md -->
  {projects.length > 0 && (
    <section class="section">
      <div class="section-header project-section-head">
        <div>
          <h2 class="section-title">我的项目</h2>
          <p class="meta">从工作流到桌面工具，把想法做成可以使用的项目。</p>
        </div>
      </div>
      <div class="project-showcase-grid stagger">
        {projects.map((p) => {
          const tags = (p.data.tags ?? [])
            .flatMap((tag) => tag.split(/[,，]/))
            .map((tag) => tag.trim())
            .filter(Boolean)
            .slice(0, 3);
          const snapshot = p.data.readmeSnapshot;
          const cover = snapshot?.images.find(image => !/\.gif(?:$|\?)/i.test(image.url));
          const demo = snapshot?.images.find(image => /\.gif(?:$|\?)/i.test(image.url));
          const highlights = p.data.highlights?.length ? p.data.highlights : snapshot?.highlights || [];
          const summary = p.data.summary || snapshot?.summary || p.data.description;
          const repoUrl = /^https:\/\//i.test(p.data.repoUrl) ? p.data.repoUrl : "#";

          return (
            <article class="project-showcase">
              <ProjectPreview title={p.data.title}
                coverImage={imageUrl(safeImage(p.data.coverImage || cover?.url))}
                coverAlt={p.data.coverAlt || cover?.alt}
                demoUrl={imageUrl(safeImage(p.data.demoUrl || demo?.url))}
                client:visible />
              <div class="project-copy">
                <div class="project-title-group">
                  <p class="project-repo-name">{new URL(p.data.repoUrl).pathname.replace(/^\//, "")}</p>
                  <h3>{p.data.title}</h3>
                </div>
              <p class="project-preview-desc">{summary}</p>
              {highlights.length > 0 && <ul class="project-highlights">{highlights.map(item => <li>{item}</li>)}</ul>}
              <div class="project-tags" aria-label="项目标签">
                {tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
              <a class="project-repository-link" href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub 仓库 ↗</a>
              </div>
              <details class="project-readme">
                <summary>项目介绍 <span aria-hidden="true">＋</span></summary>
                <div class="project-readme-content">
                  {snapshot?.sections.length ? snapshot.sections.map(section => <section><h4>{section.title}</h4><p>{section.text}</p></section>)
                    : <p>{p.data.description}</p>}
                  {snapshot && <a href={snapshot.sourceUrl} target="_blank" rel="noopener noreferrer">完整 README ↗</a>}
                </div>
              </details>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- Fun Messages Section -->
  <section class="section">
    <FunMessages apiUrl={funMessagesApi} client:load />
  </section>

  <!-- Idea Collection Box Section -->
  <section class="section">
    <IdeaBox apiUrl={ideasApi} client:load />
  </section>
</BaseLayout>
