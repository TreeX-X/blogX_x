---
import BaseLayout from "../layouts/BaseLayout.astro";
import FunMessages from "../components/FunMessages";
import IdeaBox from "../components/IdeaBox";
import { getProjects } from "../lib/content";

const base = import.meta.env.BASE_URL;
const toBase = (path = "") => {
  const normalizedBase = base.endsWith("/") ? base.slice(0, -1) : base;
  const normalizedPath = path.startsWith("/") ? path.slice(1) : path;
  return normalizedPath ? `${normalizedBase}/${normalizedPath}` : `${normalizedBase}/`;
};

const funMessagesApi = toBase("api/fun-messages");
const ideasApi = toBase("api/ideas");
const projects = await getProjects();
const githubUsername = "TreeX-X";
const githubContributionsUrl = `https://ghchart.rshah.org/6B8F71/${githubUsername}`;
const projectStatus = "Temporary Lab";
---

<BaseLayout title="BlogX_x | 关于" description="关于 BlogX_x 和作者。">
  <!-- About Me -->
  <section>
    <h1 class="section-title">关于我</h1>
    <div class="card about-profile-card">
      <div class="about-profile-head">
        <div class="about-avatar">
          <img src={toBase("about/me.png")} alt="avatar" />
        </div>
        <div class="about-profile-copy">
          <p>
            我在这里记录技术实践、设计思考和知识库沉淀。BlogX_x
            的目标是保持克制表达，长期更新。
          </p>
        </div>
      </div>

      <div class="about-social-wrap">
        <a
          class="github-entry"
          href={`https://github.com/${githubUsername}`}
          target="_blank"
          rel="noreferrer"
          aria-label={`访问 ${githubUsername} 的 GitHub 主页`}
        >
          <span class="github-entry-ring" aria-hidden="true"></span>
          <span class="github-entry-icon-shell" aria-hidden="true">
            <img
              class="github-entry-icon"
              src={toBase("logo/githubLogo.svg")}
              alt=""
            />
          </span>
          <span class="github-entry-text">@{githubUsername} on GitHub</span>
        </a>
      </div>

      <a
        class="github-contrib-card"
        href={`https://github.com/${githubUsername}`}
        target="_blank"
        rel="noreferrer"
        aria-label={`查看 ${githubUsername} 的 GitHub 提交日历`}
      >
        <div class="github-contrib-head">
          <span>GitHub 提交日历</span>
          <span class="github-contrib-user">@{githubUsername}</span>
        </div>
        <div class="github-contrib-visual">
          <img
            src={githubContributionsUrl}
            alt={`${githubUsername} 的 GitHub contributions calendar`}
            loading="lazy"
          />
        </div>
        <div class="github-contrib-foot" aria-hidden="true">
          <span>Less</span>
          <span class="github-contrib-dot level-0"></span>
          <span class="github-contrib-dot level-1"></span>
          <span class="github-contrib-dot level-2"></span>
          <span class="github-contrib-dot level-3"></span>
          <span>More</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Projects Showcase -->
  {projects.length > 0 && (
    <section class="section">
      <div class="section-header project-section-head">
        <div>
          <h2 class="section-title">我的项目</h2>
          <p class="meta">暂时放在这里的实验项目，记录正在形成的工作方式。</p>
        </div>
        <span class="project-count">{projects.length} item{projects.length > 1 ? "s" : ""}</span>
      </div>
      <div class="project-showcase-grid stagger">
        {projects.map((p, index) => {
          const tags = p.data.tags?.slice(0, 4) ?? [];
          const phase = index === 0 ? "Active Draft" : "Archived Note";

          return (
            <a class="project-preview-card" href={p.data.repoUrl} target="_blank" rel="noreferrer">
              <div class="project-preview-main">
                <div class="project-kicker">
                  <span>{projectStatus}</span>
                  <span>{phase}</span>
                </div>
                <div class="project-title-row">
                  <span class="project-mark" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{p.data.title}</h3>
                </div>
                <p class="project-preview-desc">{p.data.description}</p>
                <div class="project-signal-row" aria-label="项目组成">
                  <span>Prompt</span>
                  <span>Spec</span>
                  <span>Agent</span>
                  <span>Review</span>
                </div>
                {tags.length ? (
                  <div class="project-tags">
                    {tags.map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                ) : null}
              </div>
              <div class="project-preview-visual" aria-hidden="true">
                <div class="project-visual-head">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="project-flow-map">
                  <span class="flow-node node-a"></span>
                  <span class="flow-node node-b"></span>
                  <span class="flow-node node-c"></span>
                  <span class="flow-node node-d"></span>
                  <span class="flow-line line-a"></span>
                  <span class="flow-line line-b"></span>
                  <span class="flow-line line-c"></span>
                </div>
                <div class="project-visual-notes">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
              <div class="project-preview-foot">
                <span>View repository</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Fun Messages Section -->
  <section class="section">
    <FunMessages apiUrl={funMessagesApi} client:load />
  </section>

  <!-- Idea Collection Box Section -->
  <section class="section">
    <IdeaBox apiUrl={ideasApi} client:load />
  </section>
</BaseLayout>
